# Salin ke docker/.env lalu sesuaikan nilai sebelum menjalankan Docker.
#   docker compose --env-file docker/.env up -d

DB_NAME=drydock
DB_USER=drydock_app
DB_PASSWORD=ganti-dengan-password-database
MYSQL_ROOT_PASSWORD=ganti-dengan-password-root

# Wajib diganti. Minimal 32 karakter.
JWT_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter
JWT_REFRESH_SECRET=ganti-dengan-rahasia-acak-minimal-32-karakter

BACKEND_PORT=3000
FRONTEND_PORT=5173